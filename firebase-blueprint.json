{
  "entities": {
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform payment, check-in, bonus, and maintenance configuration.",
      "type": "object",
      "properties": {
        "merchantUpiId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "merchantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "dailyCheckInCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32,
          "pattern": "^[A-Z0-9]+$"
        },
        "checkInRewardAmount": {
          "type": "number"
        },
        "signupBonusAmount": {
          "type": "number"
        },
        "maxWithdrawalAmount": {
          "type": "number"
        },
        "maintenanceMode": {
          "type": "boolean"
        },
        "qrMode": {
          "type": "string",
          "enum": ["generated", "uploaded"]
        },
        "customQrDataUrl": {
          "type": "string",
          "maxLength": 260000
        },
        "activeBroadcast": {
          "$ref": "#/entities/BroadcastMessage"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "merchantUpiId",
        "merchantName",
        "dailyCheckInCode",
        "checkInRewardAmount",
        "signupBonusAmount",
        "maxWithdrawalAmount",
        "maintenanceMode",
        "updatedAt"
      ]
    },
    "BroadcastMessage": {
      "title": "BroadcastMessage",
      "description": "Admin system-wide alert or promotional toast notification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "minLength": 4,
          "maxLength": 240
        },
        "tone": {
          "type": "string",
          "enum": ["promo", "info", "warning"]
        },
        "active": {
          "type": "boolean"
        },
        "sentAt": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        }
      },
      "required": ["id", "title", "message", "tone", "active", "sentAt"]
    },
    "InvestmentPlanConfig": {
      "title": "InvestmentPlanConfig",
      "description": "BE6 vehicle investment plan catalog configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["normal", "vip"]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "modelName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "dailyIncome": {
          "type": "number"
        },
        "totalIncome": {
          "type": "number"
        },
        "durationDays": {
          "type": "number"
        },
        "investmentAmount": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "featured": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "category",
        "name",
        "modelName",
        "subtitle",
        "dailyIncome",
        "totalIncome",
        "durationDays",
        "investmentAmount",
        "imageUrl",
        "featured",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative admin allowlist record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated investor profile, wallet balance, referral attribution, and bank settlement details.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10,
          "pattern": "^(|[0-9]{10})$"
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "balance": {
          "type": "number"
        },
        "referralCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]{6,16}$"
        },
        "referredByCode": {
          "type": "string",
          "maxLength": 16
        },
        "referredByUid": {
          "type": "string",
          "maxLength": 128
        },
        "bankDetails": {
          "type": "object"
        },
        "lastCheckInDate": {
          "type": "string",
          "maxLength": 20
        },
        "lastCheckInReward": {
          "type": "number"
        },
        "lastPlanActionId": {
          "type": "string",
          "maxLength": 128
        },
        "darkMode": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "userName",
        "email",
        "phone",
        "accountStatus",
        "balance",
        "referralCode",
        "darkMode",
        "createdAt",
        "updatedAt",
        "lastLoginAt"
      ]
    },
    "UserActivePlan": {
      "title": "UserActivePlan",
      "description": "Purchased fleet investment plan owned by an investor.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "planId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "modelName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "dailyIncome": {
          "type": "number"
        },
        "totalIncome": {
          "type": "number"
        },
        "durationDays": {
          "type": "number"
        },
        "investmentAmount": {
          "type": "number"
        },
        "purchasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "daysClaimed": {
          "type": "number"
        },
        "lastClaimDate": {
          "type": "string",
          "maxLength": 20
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "planId",
        "name",
        "modelName",
        "dailyIncome",
        "totalIncome",
        "durationDays",
        "investmentAmount",
        "purchasedAt",
        "daysClaimed",
        "imageUrl",
        "updatedAt"
      ]
    },
    "UserTransaction": {
      "title": "UserTransaction",
      "description": "Immutable investor wallet transaction ledger entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "kind": {
          "type": "string",
          "enum": ["withdrawal", "purchase", "recharge", "checkin", "yield", "bonus", "admin"]
        },
        "amount": {
          "type": "number"
        },
        "isCredit": {
          "type": "boolean"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "userName",
        "description",
        "kind",
        "amount",
        "isCredit",
        "timestamp"
      ]
    },
    "RechargeRequest": {
      "title": "RechargeRequest",
      "description": "UPI/QR recharge request awaiting admin verification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "userPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "amount": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["UPI_ID", "QR_CODE", "DIRECT_IMPS"]
        },
        "utrNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 22,
          "pattern": "^[A-Z0-9]{10,22}$"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "userName",
        "userPhone",
        "amount",
        "method",
        "utrNumber",
        "status",
        "createdAt"
      ]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "IMPS withdrawal request submitted by an investor.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "userPhone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "withdrawalAmount": {
          "type": "number"
        },
        "claimFeeAmount": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["UPI_ID", "QR_CODE", "DIRECT_IMPS"]
        },
        "utrNumber": {
          "type": "string",
          "minLength": 10,
          "maxLength": 22,
          "pattern": "^[A-Z0-9\\-]{10,22}$"
        },
        "bankDetails": {
          "type": "object"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"]
        },
        "rejectionReason": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "uid",
        "userName",
        "userPhone",
        "withdrawalAmount",
        "claimFeeAmount",
        "method",
        "utrNumber",
        "bankDetails",
        "status",
        "createdAt"
      ]
    },
    "ReferralCodeIndex": {
      "title": "ReferralCodeIndex",
      "description": "Publicly resolvable referral code lookup entry (contains no PII).",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]{6,16}$"
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "ownerUid", "createdAt"]
    },
    "ReferralRecord": {
      "title": "ReferralRecord",
      "description": "Referral relationship and Level 1 commission tracking record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referrerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referredUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 16,
          "pattern": "^[A-Z0-9]{6,16}$"
        },
        "referredName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "maskedPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "level": {
          "type": "number"
        },
        "rechargeAmount": {
          "type": "number"
        },
        "commissionEarned": {
          "type": "number"
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "referrerUid",
        "referredUid",
        "inviteCode",
        "referredName",
        "maskedPhone",
        "level",
        "rechargeAmount",
        "commissionEarned",
        "joinedAt"
      ]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration (singleton 'platform')."
    },
    "/plans/{planId}": {
      "schema": { "$ref": "#/entities/InvestmentPlanConfig" },
      "description": "Catalog of available Mahindra BE6 investment plans."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authoritative admin UID registry."
    },
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private investor profile, balance, and settlement bank details."
    },
    "/users/{uid}/activePlans/{activePlanId}": {
      "schema": { "$ref": "#/entities/UserActivePlan" },
      "description": "Investor's active and completed fleet plans."
    },
    "/users/{uid}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/UserTransaction" },
      "description": "Immutable investor transaction ledger."
    },
    "/rechargeRequests/{requestId}": {
      "schema": { "$ref": "#/entities/RechargeRequest" },
      "description": "UPI/QR recharge requests pending admin review."
    },
    "/withdrawalRequests/{requestId}": {
      "schema": { "$ref": "#/entities/WithdrawalRequest" },
      "description": "IMPS withdrawal claims pending admin review."
    },
    "/referralCodes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCodeIndex" },
      "description": "Exact-match referral code index mapping code to owner UID without PII."
    },
    "/referrals/{referralId}": {
      "schema": { "$ref": "#/entities/ReferralRecord" },
      "description": "Referral relationships and Level 1 commission tracking."
    }
  }
}
